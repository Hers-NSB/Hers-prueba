{
  "name": "hers-prueba",
  "main": "cloudflare/entrypoint.js",
  "compatibility_date": "2026-11-20",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/admin/integrations",
      "/api/admin/integrations/*",
      "/api/admin/dropper/*",
      "/v1/*",
      "/restablecer-contrasena",
      "/restablecer-contrasena/"
    ]
  },
  "d1_databases": [
    {
      "binding": "DROPPER_DB",
      "database_name": "hers-prueba",
      "database_id": "6b7b6025-e9cd-4bb4-b758-a8578ad6ccb2",
      "migrations_dir": "dropper/cloudflare/migrations"
    }
  ],
  "triggers": {
    "crons": [
      "5,20,35,50 * * * *",
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
